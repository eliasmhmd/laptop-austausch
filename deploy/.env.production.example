# Produktions-Konfiguration für Laptop-Austausch.
# Diese Datei wird von deploy/setup.sh nach .env kopiert und ausgefüllt
# (APP_KEY, APP_URL und DB_PASSWORD werden automatisch gesetzt).

APP_NAME="Laptop-Austausch"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://SERVER_ADRESSE

# Deutsch (wichtig für Datums-/Wochentagsnamen).
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Im Produktivbetrieb nur Fehler protokollieren.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Datenbank (lokale MariaDB).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laptop_austausch
DB_USERNAME=laptop_app
DB_PASSWORD=

# WICHTIG: Sitzungen als Datei – die App hat KEINE sessions-Tabelle.
# (Mit dem Standard "database" würde die Anmeldung fehlschlagen.)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Kein Hintergrund-Worker, kein externer Cache nötig.
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# Kein E-Mail-Versand (Server hat keinen Mailzugang).
MAIL_MAILER=log

BCRYPT_ROUNDS=12
